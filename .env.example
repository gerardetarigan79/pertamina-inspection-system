# Runtime Neon URL: use the pooled hostname (-pooler) and SSL.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Direct Neon URL for schema migrations and one-time admin seeding (no -pooler hostname).
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Must be at least 32 characters. Never commit the real value.
AUTH_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# One-time seed values. Set only while running npm run db:seed-admin, then remove them.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-unique-password-of-at-least-12-characters"
